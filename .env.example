# ============================================================
#  Day Pilot – Environment Configuration
#  Copy this file to .env and fill in your values.
# ============================================================

# -------------------------------------------------------
# General
# -------------------------------------------------------
APP_NAME=Day Pilot
APP_TIMEZONE=Europe/Berlin
# Time for the daily push notification (HH:MM in APP_TIMEZONE)
DAILY_SUMMARY_TIME=07:00

# -------------------------------------------------------
# OpenAI  (https://platform.openai.com)
# -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------
# Weather  (https://openweathermap.org/api)
# -------------------------------------------------------
OPENWEATHERMAP_API_KEY=
WEATHER_CITY=Berlin
WEATHER_UNITS=metric          # metric | imperial

# -------------------------------------------------------
# Google Calendar / Tasks / Contacts
# Place your OAuth2 credentials.json in ./data/ and point
# GOOGLE_CREDENTIALS_JSON to it.
# -------------------------------------------------------
GOOGLE_CREDENTIALS_JSON=/app/data/credentials.json
GOOGLE_TOKEN_JSON=/app/data/google_token.json

# -------------------------------------------------------
# Apple Calendar via CalDAV (iCloud)
# iCloud CalDAV URL: https://caldav.icloud.com
# Use an App-Specific Password for CALDAV_PASSWORD.
# -------------------------------------------------------
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# -------------------------------------------------------
# Push Notifications  (https://ntfy.sh)
# Create a free topic at ntfy.sh or self-host ntfy.
# -------------------------------------------------------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=                   # optional, for private topics

# -------------------------------------------------------
# Voice-control webhook
# Used by Siri Shortcuts / Google Assistant IFTTT webhooks.
# Set a strong random secret here.
# -------------------------------------------------------
VOICE_WEBHOOK_SECRET=change-me-in-production
