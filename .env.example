# ============================================================
#  Day Pilot – Environment Configuration
#  Copy this file to .env and fill in your values.
# ============================================================

# -------------------------------------------------------
# General
# -------------------------------------------------------
APP_NAME=Day Pilot
APP_TIMEZONE=Europe/Berlin
# Application language for UI defaults and AI prompts: en | de
APP_LANGUAGE=en
# Time for the daily push notification (HH:MM in APP_TIMEZONE)
DAILY_SUMMARY_TIME=07:00
# How often the calendar sync job runs (full hours, default: 1)
CALENDAR_SYNC_INTERVAL_HOURS=1

# -------------------------------------------------------
# Persistence
# -------------------------------------------------------
# Day Pilot stores all state as JSON files under /app/data (bind-mounted by
# docker-compose, backed by a PVC in the Helm chart). No database or Redis is
# required. The PostgreSQL/Redis services are disabled by default.

# -------------------------------------------------------
# OpenAI  (https://platform.openai.com)
# Used when AI_PROVIDER=openai (the default).
# -------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -------------------------------------------------------
# AI Provider & Model selection
# Set AI_PROVIDER to the provider you want to use.
# AI_MODEL overrides the provider-specific default model.
# Leave AI_MODEL empty to use the default model for your chosen provider.
# -------------------------------------------------------
AI_PROVIDER=openai            # openai | github | groq | google
AI_MODEL=                     # e.g. gpt-4o-mini, llama-3.3-70b-versatile, gemini-2.0-flash

# -------------------------------------------------------
# GitHub Models  (https://github.com/marketplace/models)
# Used when AI_PROVIDER=github.
# Create a Personal Access Token at https://github.com/settings/tokens
# and grant it the "models:read" permission (fine-grained token) or
# leave all permissions on a classic token.
# -------------------------------------------------------
GITHUB_TOKEN=                 # ghp_… or github_pat_…

# -------------------------------------------------------
# Groq  (https://console.groq.com)  — free tier available
# Used when AI_PROVIDER=groq.
# Sign up at console.groq.com and create a free API key.
# Free models: llama-3.3-70b-versatile, llama-3.1-8b-instant, gemma2-9b-it
# -------------------------------------------------------
GROQ_API_KEY=                 # gsk_…

# -------------------------------------------------------
# Google AI Studio  (https://aistudio.google.com)  — free tier available
# Used when AI_PROVIDER=google.
# Get a free API key at aistudio.google.com/app/apikey
# Free models: gemini-2.0-flash, gemini-1.5-flash, gemini-1.5-flash-8b
# -------------------------------------------------------
GOOGLE_AI_API_KEY=            # AIza…

# -------------------------------------------------------
# Weather  (https://www.weatherapi.com/)
# -------------------------------------------------------
WEATHERAPI_API_KEY=
WEATHER_CITY=Berlin
WEATHER_UNITS=metric          # metric | imperial

# -------------------------------------------------------
# iCal Calendars (read-only)
# Works with Google Calendar, Apple iCloud, Outlook, and any calendar
# that exposes a public or private iCal (.ics) feed.
#
# Google Calendar → Settings → Integrate calendar → iCal URL (private address)
# Apple iCloud    → Share calendar → copy the .ics link
#
# Multiple URLs can be provided as a comma-separated list.
# Example:
# ICAL_URLS=https://calendar.google.com/calendar/ical/abc123/private-xyz/basic.ics,https://p61-caldav.icloud.com/published/2/xyz/calendar
# -------------------------------------------------------
ICAL_URLS=

# -------------------------------------------------------
# Apple Calendar via CalDAV (iCloud)
# iCloud CalDAV URL: https://caldav.icloud.com
# Use an App-Specific Password for CALDAV_PASSWORD.
# Single account:
# -------------------------------------------------------
CALDAV_URL=
CALDAV_USERNAME=
CALDAV_PASSWORD=

# Multiple CalDAV accounts (optional):
# Set CALDAV_CONFIGS as a JSON array to connect more than one CalDAV/iCloud account.
# When this is set it overrides the single-account variables above.
# Example (all on one line):
# CALDAV_CONFIGS=[{"url":"https://caldav.icloud.com","username":"you@icloud.com","password":"xxxx-xxxx-xxxx-xxxx"},{"url":"https://caldav.icloud.com","username":"partner@icloud.com","password":"yyyy-yyyy-yyyy-yyyy"}]
CALDAV_CONFIGS=

# -------------------------------------------------------
# Structured iCal feeds (optional). JSON array of {url, is_birthday}.
# Takes precedence over ICAL_URLS when set. Entries with is_birthday=true
# force every event from that feed to be classified as a birthday.
# Example: [{"url":"https://…/basic.ics","is_birthday":false}]
# -------------------------------------------------------
ICAL_FEEDS=

# Comma-separated calendar names that are treated as birthday-only feeds
# (case-insensitive match).
BIRTHDAY_CALENDAR_NAMES=Bdays,Birthdays,Geburtstage,Contacts

# -------------------------------------------------------
# Local persistent storage paths (inside the backend container)
# -------------------------------------------------------
LOCAL_EVENTS_FILE=/app/data/local_events.json
LOCAL_TODOS_FILE=/app/data/local_todos.json
LOCAL_SHOPPING_FILE=/app/data/local_shopping.json

# -------------------------------------------------------
# Family member configuration
# FAMILY_MEMBERS: comma-separated legacy fallback list of names
# FAMILY_MEMBERS_FILE: JSON file with full profiles (name, age, notes)
# -------------------------------------------------------
FAMILY_MEMBERS=
FAMILY_MEMBERS_FILE=/app/data/family_members.json

# Notification dedup marker file (prevents duplicate daily pushes)
NOTIFICATIONS_DEDUP_FILE=/app/data/notification_dedup.json

# -------------------------------------------------------
# Custom AI prompt template (optional). Replaces the built-in briefing
# instruction when set. Available placeholders: {language}, {date}, {data}.
# -------------------------------------------------------
AI_PROMPT_TEMPLATE=

# -------------------------------------------------------
# Push Notifications  (https://ntfy.sh)
# Create a free topic at ntfy.sh or self-host ntfy.
# -------------------------------------------------------
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=                   # optional, for private topics

# -------------------------------------------------------
# Frontend API URL (optional – advanced / split-origin setups only)
# By default the frontend uses a relative /api path so nginx proxies
# requests to the backend container.  Set this ONLY if the frontend is
# served from a different origin than the backend (e.g. separate
# reverse-proxy vhosts).  The value is baked into the JS bundle at
# build time, so the container must be rebuilt after changing it.
# -------------------------------------------------------
VITE_API_URL=

# -------------------------------------------------------
# Voice-control webhook (Siri Shortcuts / IFTTT / Google Assistant).
# REQUIRED to enable the webhook endpoints. When empty, the /api/voice/*
# routes are NOT mounted. Generate a strong secret:
#   openssl rand -hex 32
# -------------------------------------------------------
VOICE_WEBHOOK_SECRET=

# -------------------------------------------------------
# CORS — comma-separated allowed origins. Leave empty for local dev defaults.
# -------------------------------------------------------
CORS_ALLOW_ORIGINS=
